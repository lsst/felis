{% extends "base.html.j2" %}
{% import "page_macros.j2" as page_macros %}
{% block content %}
          <section class="panel panel-plain" id="{{ table | anchor }}">
          {% if table.description %}
          <p>{{ table.description }}</p>
          {% endif %}
          {% if table.primary_key %}
          <h3 id="{{ table | anchor }}-primary-key">Primary Key</h3>
          <p>
            {{ page_macros.column_links(table.primary_key | columns) }}
          </p>
          {% endif %}
          <h3 id="{{ table | anchor }}-columns">Columns</h3>
          <div class="column-details-actions" role="group" aria-label="Column details controls">
            <button type="button" class="tree-action-button" data-column-details-action="expand-all">Show all details</button>
            <button type="button" class="tree-action-button" data-column-details-action="collapse-all">Hide all details</button>
          </div>
          <table>
            <thead>
              <tr>
                <th>Column</th>
                <th>Datatype</th>
                <th>UCD</th>
                <th>Unit</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              {% for column in table.columns %}
              {% set details = column | details %}
              <tr id="{{ column | anchor }}">
                <td
                  {% if details %}
                  class="column-details-toggle-cell"
                  data-column-details-target="{{ column | anchor }}-details"
                  aria-expanded="false"
                  title="Click to show details."
                  tabindex="0"
                  role="button"
                  {% endif %}
                >
                  {{ column.name }}
                </td>
                <td>{{ column.datatype }}</td>
                <td>{{ column.ivoa_ucd }}</td>
                <td>{{ column.ivoa_unit or column.fits_tunit }}</td>
                <td>{{ column.description }}</td>
              </tr>
              {% if details %}
              <tr id="{{ column | anchor }}-details" class="column-details-row" hidden>
                <td colspan="5">
                  <table class="column-details-table">
                    <tbody>
                      {% for key, value in details %}
                      <tr>
                        <th class="field-key">{{ key }}</th>
                        <td class="field-value">{{ value }}</td>
                      </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                </td>
              </tr>
              {% endif %}
              {% endfor %}
            </tbody>
          </table>
          {% if table.indexes %}
          <h3 id="{{ table | anchor }}-indexes">Indexes</h3>
          <table>
            <thead>
              <tr>
                <th>Index</th>
                <th>Type</th>
                <th>Definition</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              {% for index in table.indexes %}
              <tr id="{{ index | anchor }}">
                <td>{{ index.name }}</td>
                <td>{{ "expressions" if index.columns is none else "columns" }}</td>
                <td>
                  {% if index.columns is not none %}
                  {{- page_macros.column_links(index.columns | columns) -}}
                  {% else %}
                  {{ index.expressions | join(', ') }}
                  {% endif %}
                </td>
                <td>{{ index.description }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% endif %}
          {% if table.constraints %}
          <h3 id="{{ table | anchor }}-constraints">Constraints</h3>
          <table>
            <thead>
              <tr>
                <th>Constraint</th>
                <th>Type</th>
                <th>Definition</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              {% for constraint in table.constraints %}
              <tr id="{{ constraint | anchor }}">
                <td>{{ constraint.name }}</td>
                <td>{{ constraint.type }}</td>
                <td>
                  {% if constraint.type == "Check" %}
                  <code>{{ constraint.expression }}</code>
                  {% elif constraint.type == "Unique" %}
                  {{- page_macros.column_links(constraint.columns | columns) -}}
                  {% elif constraint.type == "ForeignKey" %}
                  <div>
                    <strong>Columns:</strong>&#32;
                    {{- page_macros.column_links(constraint.columns | columns) -}}
                  </div>
                  <div>
                    <strong>References:</strong>&#32;
                    {%- for column in constraint.referenced_columns | columns -%}
                    {%- if not loop.first %}, {% endif -%}
                    {%- if column is string -%}
                    {{ column }}
                    {%- else -%}
                    {%- set referenced_table = column | table_of -%}
                    <a href="{{ referenced_table | href }}">{{ referenced_table.name }}</a>.<a href="{{ column | href }}">{{ column.name }}</a>
                    {%- endif -%}
                    {%- endfor -%}
                  </div>
                  {% if constraint.on_delete %}
                  <div><strong>On Delete:</strong> {{ constraint.on_delete }}</div>
                  {% endif %}
                  {% if constraint.on_update %}
                  <div><strong>On Update:</strong> {{ constraint.on_update }}</div>
                  {% endif %}
                  {% endif %}
                  {% if constraint.deferrable %}
                  <div><strong>Deferrable:</strong> true</div>
                  {% if constraint.initially %}
                  <div><strong>Initially:</strong> {{ constraint.initially }}</div>
                  {% endif %}
                  {% endif %}
                </td>
                <td>{{ constraint.description }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% endif %}
          </section>
{% endblock %}
