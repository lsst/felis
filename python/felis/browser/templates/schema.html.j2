{% extends "base.html.j2" %}
{# DataTables adds sorting to the tables table. #}
{% block head %}
{{ page_macros.datatables_styles() }}
{% endblock %}
{% block scripts %}
{{ page_macros.datatables_scripts() }}
{% endblock %}
{% block content %}
          {% if schema.version %}
          <p class="schema-version"><strong>Version:</strong> {{ schema | version }}</p>
          {% endif %}
          <h3 id="tables">Tables</h3>
          <table class="tables-table">
            <thead>
              <tr>
                <th>name</th>
                <th>description</th>
                <th>columns</th>
              </tr>
            </thead>
            <tbody>
              {% for table in schema.tables %}
              <tr>
                <td><a href="{{ table | href }}">{{ table.name }}</a></td>
                <td>{{ table.description or "" }}</td>
                <td class="count">{{ table.columns | length }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% set diagram = schema | relationship_diagram if diagrams else none %}
          {% if diagram %}
          <h3 id="relationships">Relationships</h3>
          {# Drawn by Mermaid in sidebar.js; shown as text if it can't load. #}
          <div class="schema-diagram">
            <pre class="mermaid">
{{ diagram }}
            </pre>
            <p class="schema-diagram-actions" hidden><a href="#" class="schema-diagram-full">Open full size</a></p>
          </div>
          {% endif %}
{% endblock %}
