<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% block title %}{% endblock %}</title>
    <link rel="stylesheet" href="{{ stylesheet_href }}" />
  </head>
  <body data-site-root="{{ site_root }}"{% if current_schema is defined %} data-schema-path="{{ current_schema.output_path }}"{% endif %}{% if current_table is defined %} data-table-path="{{ current_table.output_path }}"{% endif %}>
    <div class="layout">
      <aside class="sidebar">
        <div class="sidebar-header">
          <button id="sidebar-toggle" type="button" class="sidebar-toggle" aria-expanded="true" title="Toggle sidebar">
            <svg viewBox="0 0 24 24" class="sidebar-toggle-icon" aria-hidden="true" focusable="false">
              <rect x="3" y="4" width="18" height="16" rx="4" fill="none" stroke="currentColor" stroke-width="1.8"/>
              <path d="M9 5.2v13.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
        <nav id="sidebar-tree" aria-label="Schemas"></nav>
      </aside>
      <div class="sidebar-resizer" id="sidebar-resizer" aria-hidden="true"></div>

      <main class="content">
        <header class="content-header">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            {% block breadcrumb %}{% endblock %}
          </nav>
        </header>
        <div class="content-body">
          {% block content %}{% endblock %}
        </div>
      </main>
    </div>
    <script src="{{ nav_data_href }}"></script>
    <script src="{{ script_href }}"></script>
  </body>
</html>
