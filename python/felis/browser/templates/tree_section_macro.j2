{# Macro for rendering tree sections (Columns, Indexes, Constraints) in the sidebar #}

{# Render one tree section linking to the given items on the table's page,
   skipped when there are no items unless always is set #}
{% macro render_tree_section(table, items, kind, label, always=false) %}
{% if items or always %}
<div class="tree-section tree-{{ kind }}">
  <a class="tree-section-heading" href="{{ table.output_path | href }}#{{ table.anchor }}-{{ kind }}">{{ label }}</a>
  <ul>
    {% for item in items %}
    <li>
      <a href="{{ table.output_path | href }}#{{ item.anchor }}"{% if item.description %} title="{{ item.description }}"{% endif %}>{{ item.name }}</a>
    </li>
    {% endfor %}
  </ul>
</div>
{% endif %}
{% endmacro %}

{# Render all tree sections for a table #}
{% macro render_tree_table_sections(table) %}
{{ render_tree_section(table, table.columns, "columns", "Columns", always=true) }}
{{ render_tree_section(table, table.indexes, "indexes", "Indexes") }}
{{ render_tree_section(table, table.constraints, "constraints", "Constraints") }}
{% endmacro %}
